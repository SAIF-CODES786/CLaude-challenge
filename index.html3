<style>
  :root {
    --bg: #f5f6fa;
    --card-bg: #ffffff;
    --text-dark: #1f2430;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --red: #ef4444;
    --red-bg: #fee2e2;
    --orange: #f97316;
    --orange-bg: #ffedd5;
    --green: #22c55e;
    --green-bg: #dcfce7;
    --blue: #3b82f6;
    --blue-bg: #dbeafe;
    --purple: #8b5cf6;
    --purple-bg: #ede9fe;
    --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --shadow-hover: 0 4px 12px rgba(0,0,0,0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text-dark);
    padding: 24px;
  }

  .dashboard {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 4px;
  }

  .header h1 {
    font-size: 26px;
    font-weight: 700;
  }

  .header p {
    color: var(--text-muted);
    font-size: 14px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s ease;
  }

  .card:hover {
    box-shadow: var(--shadow-hover);
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
  }

  .section-title h2 {
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toggle-icon {
    font-size: 13px;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .collapsed .toggle-icon {
    transform: rotate(-90deg);
  }

  .section-body {
    margin-top: 14px;
    overflow: hidden;
  }

  .collapsed .section-body {
    display: none;
  }

  /* Key Takeaways */
  .takeaway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .takeaway-card {
    background: var(--blue-bg);
    border-radius: 10px;
    padding: 14px;
    font-size: 14px;
    font-weight: 500;
    color: #1e3a8a;
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 480px;
  }

  th {
    text-align: left;
    padding: 10px 12px;
    background: #f9fafb;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
  }

  td {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: #fafbfc;
  }

  .task-cell {
    font-weight: 600;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-red { background: var(--red-bg); color: #b91c1c; }
  .badge-orange { background: var(--orange-bg); color: #c2410c; }
  .badge-green { background: var(--green-bg); color: #15803d; }
  .badge-blue { background: var(--blue-bg); color: #1d4ed8; }
  .badge-purple { background: var(--purple-bg); color: #6d28d9; }
  .badge-gray { background: #f3f4f6; color: #4b5563; }

  /* Open Questions / Risks lists */
  .item-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .item-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #f9fafb;
    border: 1px solid var(--border);
    font-size: 14px;
  }

  .item-row.risk {
    background: var(--red-bg);
    border-color: #fecaca;
  }

  .item-row.question {
    background: var(--orange-bg);
    border-color: #fed7aa;
  }

  .item-text {
    flex: 1;
    color: var(--text-dark);
  }

  .not-specified {
    color: var(--text-muted);
    font-style: italic;
  }

  .empty-note {
    color: var(--text-muted);
    font-size: 14px;
  }

  @media (max-width: 600px) {
    body { padding: 14px; }
    .header h1 { font-size: 21px; }
    .card { padding: 16px; }
  }
</style>

<div class="dashboard">

  <div class="header">
    <h1>📋 Meeting Notes Dashboard</h1>
    <p>Structured breakdown of raw meeting notes</p>
  </div>

  <!-- Summary -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>🧾 Summary</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <p>Team meeting covering a Full Stack project. Saif is assigned frontend work with a Friday deadline, Ali is assigned backend API development, and the team still needs to finalize the MongoDB schema. Express.js and MongoDB have been decided as the tech stack. An open question remains around image storage (Cloudinary vs local), and a short deadline has been flagged as a risk.</p>
    </div>
  </div>

  <!-- Key Takeaways -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>✨ Key Takeaways</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <div class="takeaway-grid">
        <div class="takeaway-card">Saif is responsible for completing the frontend by Friday.</div>
        <div class="takeaway-card">Ali will develop the backend APIs.</div>
        <div class="takeaway-card">MongoDB schema still needs to be finalized by the team.</div>
        <div class="takeaway-card">Tech stack decision: Express.js + MongoDB.</div>
      </div>
    </div>
  </div>

  <!-- Action Items -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>✅ Action Items</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Task</th>
              <th>Owner</th>
              <th>Deadline</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="task-cell">Complete the frontend</td>
              <td>Saif</td>
              <td>Friday</td>
              <td><span class="badge badge-orange">⏳ Pending</span></td>
            </tr>
            <tr>
              <td class="task-cell">Develop backend APIs</td>
              <td>Ali</td>
              <td><span class="not-specified">Not specified</span></td>
              <td><span class="badge badge-orange">⏳ Pending</span></td>
            </tr>
            <tr>
              <td class="task-cell">Finalize MongoDB schema</td>
              <td><span class="not-specified">Not specified</span> (Team)</td>
              <td><span class="not-specified">Not specified</span></td>
              <td><span class="badge badge-orange">⏳ Pending</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Open Questions -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>❓ Open Questions</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <div class="item-list">
        <div class="item-row question">
          <span class="badge badge-orange">❓ Open Question</span>
          <span class="item-text">Should we use Cloudinary or local image storage?</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Risks / Blockers -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>⚠️ Risks / Blockers</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <div class="item-list">
        <div class="item-row risk">
          <span class="badge badge-red">🔴 High Priority</span>
          <span class="item-text">Deadline is very short.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Conflicts -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>⚠️ Conflicts</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <p class="empty-note">No conflicts identified in the provided notes.</p>
    </div>
  </div>

  <!-- Additional Notes -->
  <div class="card">
    <div class="section-title" onclick="this.parentElement.classList.toggle('collapsed')">
      <h2>📌 Additional Notes</h2>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <p class="empty-note">Decision recorded: Use Express.js and MongoDB. No additional supporting context provided.</p>
    </div>
  </div>

</div>
