<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <p>Edit Chat : <%= chat._id %></p>
    <p>This chat was sent from: <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea placeholder="write your message here..." name="newMsg" rows="4" cols="50"><%= chat.message %></textarea>
        <br/>
        <br/>
        <button type="submit">Update Message</button>
    </form>
</body>
</html>