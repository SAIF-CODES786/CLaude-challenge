<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Details</title>
</head>
<body>

    <h2>Chat Details</h2>

    <p><b>From:</b> <%= chat.from %></p>
    <p><b>To:</b> <%= chat.to %></p>
    <p><b>Message:</b> <%= chat.message %></p>
    <p><b>Created At:</b> <%= chat.created_at %></p>

</body>
</html>