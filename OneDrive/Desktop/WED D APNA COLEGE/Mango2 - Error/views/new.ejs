<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write new chat</title>
</head>
<body>
    <h3>Write a new chat...</h3>
    <form method="POST" action="/chats">
        <input placeholder="who are you?" name="from"/>
        <br/>
        <br/>
        <input placeholder="who are you sending to?" name="to"/>
        <br/>
        <br/>
        <textarea placeholder="write your message here..." name="message"></textarea>
        <br/>
        <br/>
        <button type="submit">Send Message</button>
    </form>
</body>
</html>