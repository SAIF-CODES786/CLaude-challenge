<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="style.css"/>
</head>
<body>
    <h1>Whatsapp Chats</h1>
    <form action="/chats/new" method="GET">
        <button type="submit">New Chat</button>
    </form>
    <br/>
    <% for(let chat of chats) { %>
    <div class="chat">
        <p>From: <i> <%= chat.from %></i> </p>
        <div class="message">
        <p>Message: <%= chat.message %></p>
        <form method="GET" action="/chats/<%= chat._id %>/edit">
            <button>edit</button>
        </form>
        <br/>
        <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
            <button>delete</button>
        </form>
        </div>
        <p>Recieved by: <i> <%= chat.to %> </i></p>
        <hr/> 
        <p>Sent at: <%= chat.created_at.toString().split(" ")[4] %></p>
        <p>Sent at: <%= chat.created_at.toString().split(" ").slice(0, 4).join(" ") %></p>
        <form action="/chats/<%= chat._id %>" method="GET">
        <button>Show</button>
        </form>
    </div>
<% } %>
</body>
</html>

